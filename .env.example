# Copy to the repository-root .env and fill only the values needed locally.
# Never commit .env or put credential values in logs, commands, or job state.

# OCR / MinerU
BAIDU_PADDLEOCR_TOKEN=
BAIDU_PADDLEOCR_JOB_URL=
BAIDU_PADDLEOCR_MODEL=
BAIDU_POLL_SECONDS=
BAIDU_STALLED_JOB_SECONDS=
BAIDU_MAX_UPLOAD_MB=
REQUEST_TIMEOUT_SECONDS=
MAX_OCR_PAGES_PER_RUN=
MAX_OCR_PAGES_PER_JOB=
WORKERS=
MINERU_API_TOKEN=
MINERU_TOKEN=
MINERU_MODEL_VERSION=
MINERU_LANGUAGE=
OCR_OUTPUT_ROOT=
FORCE_OCR_ITEM_TYPES=
TEXT_EXTRACT_SAMPLE_MIN_CHARS=
TEXT_EXTRACT_PAGE_MIN_CHARS=
DIRTY_TEXT_LAYER_GUARD=
DIRTY_TEXT_MIN_SAMPLE_CHARS=
DIRTY_TEXT_FULLWIDTH_ALNUM_RATIO=
DIRTY_TEXT_PRIVATE_USE_RATIO=

# Zotero
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=
ZOTERO_STORAGE=
ZOTERO_LOCAL_API=
CROSSREF_CONTACT=

# Embedding
ZSEARCH_EMBEDDING_BACKEND=
ZSEARCH_EMBEDDING_DIM=
GEMINI_API_KEY=
GOOGLE_API_KEY=
JINA_API_KEY=
DASHSCOPE_API_KEY=

# LLM translation (#60)
# Each provider's multiple keys use one variable, separated by commas or
# newlines. The provider registry references the environment variable name.
GEMINI_API_KEYS=
OPENAI_COMPATIBLE_API_KEYS=
QWEN_PAYG_API_KEYS=
VOLCENGINE_ARK_API_KEYS=

# Book Pipeline terminal notifications (#51)
# Optional HTTP(S) endpoint. The launcher sends only safe job metadata and a
# deterministic Idempotency-Key; source titles, paths, logs, and credentials
# are excluded from the payload.
BOOK_PIPELINE_WEBHOOK_URL=
