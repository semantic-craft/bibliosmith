**/node_modules/
**/__pycache__/
*.pyc

# uv creates .venv at the workspace root and regenerates it on any `uv run`.
**/.venv/

# macOS Finder metadata.
.DS_Store

# Local credentials and machine-specific environment. Commit only the empty
# repository-wide registry.
.env
.env.*
!.env.example

# BiblioSmith Launcher local build cache. These directories are regenerated by
# `npm install`, `npm run build`, or `npm run tauri:build`.
tools/bibliosmith-launcher/source/dist/
tools/bibliosmith-launcher/source/src-tauri/target/
tools/bibliosmith-launcher/source/src-tauri/gen/
.playwright-mcp/
launcher-console.txt
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
# Launcher installers are published as project release attachments.
tools/bibliosmith-launcher/*.exe

# Local Codex/agent instructions and environment notes.
# Keep project-specific operational preferences here instead of global memory.
.codex/
.agents/
.claude/

# Local private docs should never be tracked.
doc/private/

# Real local reading projects: source books, extracted text, translations, QA,
# and generated EPUBs stay machine-local unless explicitly synced.
books/local/**
!books/local/
!books/local/.gitignore

# Book-specific screenshot/debug captures must stay under the matching book project.
/bibliosmith-*.png
