{
  "$schema": "https://opencode.ai/config.json",

  // Thin OpenCode adapter. AGENTS.md and the local-reading skill are the
  // shared entrypoints for every local-file client.
  "instructions": [
    "AGENTS.md",
    "skills/local-book-reading-pipeline/SKILL.md"
  ],

  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "default_agent": "book-runner",

  "skills": {
    "paths": [
      "skills"
    ]
  },

  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": "deny"
  },

  "watcher": {
    "ignore": [
      ".git/**",
      ".playwright-mcp/**",
      "books/node_modules/**",
      "**/node_modules/**",
      "**/output/**",
      "**/tmp/**",
      "**/.cache/**"
    ]
  }
}
