            "referenceFiles": ["AGENTS.md", ".opencode/agents/book-runner.md", ".opencode/agents/book-reviewer.md", ".opencode/commands/run-gates.md", ".opencode/commands/random-spotcheck.md"],
            "skillVersions": {"expert-translation-quality": "sha256:project-whitelist"},
