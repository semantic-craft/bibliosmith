          },
          "contextPolicy": "阶段输入按最小必要范围提供；独立复核不得读取译者的自评结论；发现问题族后扩展到全书候选并用新证据关闭。",
          "requiredSkillIds": ["expert-translation-quality"],
          "requiredEvidence": ["research-brief", "calibration-result", "chapter-control", "multidimensional-review", "independent-review", "defect-family-closure", "rollback-receipt", "final-gate"],
