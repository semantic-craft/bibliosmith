{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiblioSmith Launcher",
  "version": "1.16.4",
  "identifier": "com.bibliosmith.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BiblioSmith Launcher",
        "width": 1280,
        "height": 760,
        "minWidth": 1120,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 17
        },
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzMDFEMkZBOTAyMDVFNjkKUldScFhpQ1ErdElCSTdxSG1Xd3U3eHMzeDNRWHdIK3k1amt5N3JTUVRqWGJ5NlNRdFpSUjJseTIK",
      "endpoints": [
        "https://github.com/semantic-craft/bibliosmith/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "bundle-resources/sidecars/node",
      "bundle-resources/sidecars/uv"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "bundle-resources/runtime/": "bibliosmith-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application"
    }
  }
}
