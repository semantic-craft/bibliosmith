#!/usr/bin/env bash
# Last line of defence before anything leaves this machine.
#
# The repository history was re-rooted on 2026-07-23 and rebuilt on 2026-07-24
# with noreply commit identities: main descends from a clean root commit, while the pre-open-source branches and tags still carry the old
# history (copyrighted book EPUBs and build binaries). Those must never reach a
# public remote, and GitHub's push protection cannot detect them — it only knows
# about secrets.
#
#   1. Refuses to push any ref that does not descend from the clean root.
#   2. Secrets: gitleaks git over the pushed tip's reachable history.
#   3. Personal-info: gitleaks dir over a materialised tip tree (not full
#      history — older commits already contain real home paths; see #77).
#
# Applies to every remote: after the repo consolidation `origin` IS the public
# repository, so guarding a single remote name is no longer safe.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

CLEAN_ROOT=35401efd408ef12d2ebb9a1d06e5272b85529791
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch deletion, nothing to scan

  if ! git merge-base --is-ancestor "$CLEAN_ROOT" "$local_sha" 2>/dev/null; then
    echo "pre-push: refusing to push $local_ref — it does not descend from the" >&2
    echo "  clean root $CLEAN_ROOT, so it still carries the pre-open-source" >&2
    echo "  history (copyrighted book files). Push it to the private archive" >&2
    echo "  repository instead." >&2
    exit 1
  fi

  if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git . --config .gitleaks.toml --log-opts="$local_sha" \
      --no-banner --redact >/tmp/gitleaks-prepush.log 2>&1; then
      echo "pre-push: gitleaks (secrets) flagged reachable history — aborting." >&2
      sed -n '1,40p' /tmp/gitleaks-prepush.log >&2
      exit 1
    fi

    # Personal-info: only the tip tree about to become public.
    tip=$(mktemp -d)
    trap 'rm -rf "$tip"' RETURN
    git archive "$local_sha" | tar -x -C "$tip"
    cp .gitleaks-personal.toml "$tip/"
    if ! gitleaks dir "$tip" --config "$tip/.gitleaks-personal.toml" \
      --no-banner --redact >/tmp/gitleaks-prepush.log 2>&1; then
      echo "pre-push: gitleaks (personal-info) flagged tip tree of $local_ref — aborting." >&2
      sed -n '1,40p' /tmp/gitleaks-prepush.log >&2
      exit 1
    fi
    rm -rf "$tip"; trap - RETURN
  fi
done

exit 0
